generator client {
  provider = "prisma-client-js"
}

// 실서버(테스트 서버) — Supabase PostgreSQL 사용
// DATABASE_URL: 커넥션 풀링(pgbouncer) 주소 — 앱 실행 시 사용
// DIRECT_URL: 직접 연결 주소 — 빌드 시 prisma db push(스키마 반영)에 사용
datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum UserRole {
  READER
  DONOR_READER
  REPORTER
  COLUMNIST
  CHIEF_EDITOR
}

enum Gender {
  MALE
  FEMALE
}

enum ArticleStatus {
  AUTOSAVE
  DRAFT
  PUBLISHED
}

enum DonationStatus {
  ACTIVE // 결제 완료(정상) — 2026-10-08 이니시스 연동 후 의미: 결제 승인된 후원
  CANCELLED
  PENDING // 결제창 열림, 아직 승인 전 (2026-10-08 신설)
  FAILED // 결제 실패·취소 (2026-10-08 신설)
}

// 기자 신청 상태 — null(신청 이력 없음/이미 처리됨) | PENDING(승인대기) | REJECTED(반려)
// 승인되면 role이 REPORTER로 바뀌면서 이 값은 다시 null로 초기화됨 (기능정의서 3.2.1)
enum ReporterApplicationStatus {
  PENDING
  REJECTED
}

// 메인화면 3/5/7번째 카드 슬롯 + 기사 본문 삽입 광고 (기능정의서 5)
enum BannerPlacement {
  HOMEPAGE_3
  HOMEPAGE_5
  HOMEPAGE_7
  ARTICLE_BODY
}

model User {
  id                        String                     @id @default(cuid())
  email                     String                     @unique
  emailVerified             DateTime? // NextAuth 요구 필드
  name                      String
  image                     String?
  role                      UserRole                   @default(READER)
  gender                    Gender?
  nickname                  String?                    @unique // 필수+중복불허 (기능정의서 2번) — 앱 레벨에서 필수 검증, DB는 유니크만 강제
  bio                       String?                    @db.Text // 자기소개 — 기사 하단 기자 프로필에 노출 (기능정의서 3.2 신규)
  reporterApplicationStatus ReporterApplicationStatus? // 기자 신청 상태 (기능정의서 3.2.1)
  newsletterOptIn           Boolean                    @default(false) // 뉴스레터 구독 여부 — 후원 여부와 무관한 별도 옵트인 (기능정의서 6)
  isDonor                   Boolean                    @default(false)
  legacyClaimEmail          String?                    @unique // 옛 기자 임시 계정에만 — 이 구글 이메일로 로그인하면 옛 기사·기자 등급 자동 승계 (2026-10-08)
  ghost                     Boolean                    @default(false) // 유령 계정 — 관리자가 [삭제]한 옛 기자: 목록에선 숨기고 옛 기사·이름은 그대로 (2026-10-08)
  createdAt                 DateTime                   @default(now())
  // 유령기자(로그인 없는 필자 — …@legacy.invalid 계정: 외부 기고자·옛 사이트 기자) 프로필·정산 정보 (2026-10-09)
  writerTitle               String? // 직함 — 바이라인에 "이름 직함"으로 (예: 前 ○○대 교수)
  bankName                  String? // 원고료 정산용 — 편집장만 열람
  bankAccount               String?
  accountHolder             String?

  articles          Article[]
  comments          Comment[]
  accounts          Account[]
  sessions          Session[]
  donations         Donation[]
  pollVotes         PollVote[]
  snsLinks          SnsLink[]
  savedArticles     SavedArticle[]
  photos            Photo[]
  reporterDonations Donation[]      @relation("DonationReporter") // 이 기자를 지정해서 들어온 후원 (기능정의서 7)
  idImages          WriterIdImage[]
}

// 유령기자 주민등록증 사진 — 원고료 원천징수 신고용. 파일은 AES-256-GCM으로 암호화해 저장소(pii-….enc)에 두고, 편집장만 복호화해 열람 (2026-10-09)
model WriterIdImage {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  blobName  String // 저장소 파일 이름 (pii-<uuid>.enc) — /api/blob으로는 열리지 않음
  mime      String
  createdAt DateTime @default(now())
}

// 기자 프로필에 노출되는 SNS 링크 — "+" 버튼으로 여러 개 추가 가능 (기능정의서 3.2.1)
model SnsLink {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  url       String
  order     Int      @default(0)
  createdAt DateTime @default(now())
}

// 아래 3개는 NextAuth(구글 로그인) 표준 스키마 — Prisma 어댑터가 요구하는 형태 그대로
model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Category {
  id       String     @id @default(cuid())
  name     String
  slug     String     @unique
  parentId String?
  parent   Category?  @relation("CategoryToSub", fields: [parentId], references: [id])
  children Category[] @relation("CategoryToSub")
  order    Int        @default(0)

  articles Article[]
}

model Article {
  id                 String        @id @default(cuid())
  legacyId           Int?          @unique // 옛 사이트(다다미디어 CMS) 기사 번호 — 옛 주소(/news/view.php?idx=N 등) 301 리다이렉트용 (2026-10-08 신설)
  title              String
  cardTitle          String? // 홈/카테고리 카드 전용 제목 줄바꿈 — 기사 페이지/컴포저 title과 분리
  subtitle1          String? // 부제목 3줄 (기능정의서 8.2) — 전부 선택 입력
  subtitle2          String?
  subtitle3          String?
  content            String        @db.Text
  excerpt            String?
  hoverText          String? // 카드 이미지 마우스 오버 시 이미지가 dimmed되며 표시되는 흰색 문구 (2026-09-11 신설)
  themeTags          String? // "테마" — 콤마로 구분된 문자열. 아직 기능은 없고 값만 입력받아 저장(추후 사용 예정, 2026-09-11 신설)
  showOnMain         Boolean       @default(true) // 메인(인덱스) 피드 노출 여부 — 편집장이 카드 호버 (-) 버튼으로 끌 수 있음. 꺼도 키워드/검색 등 다른 화면엔 계속 노출됨 (2026-09-12 신설)
  recommendCount     Int           @default(0) // "추천" 버튼 클릭 수 — 로그인 불필요, 브라우저당 1회로 클라이언트에서만 제한 (2026-09-12 신설)
  audioUrl           String? // "읽어주기" — Google Cloud TTS로 생성해둔 오디오 파일 캐시. 본문 수정 시 PUT에서 null로 초기화되어 재생성됨 (2026-09-12 신설)
  coverImageUrl      String?
  coverFocalX        Int           @default(50) // 카드 썸네일 object-position 가로 (0=왼쪽, 100=오른쪽)
  coverFocalY        Int           @default(50) // 카드 썸네일 object-position 세로 (0=위, 100=아래)
  coverFeatureFocalX Int           @default(50) // 1면톱(featured) 카드 크롭 가로
  coverFeatureFocalY Int           @default(50) // 1면톱(featured) 카드 크롭 세로
  coverSecondFocalX  Int           @default(50) // 상단 두번째(wide 2열) 카드 크롭 가로
  coverSecondFocalY  Int           @default(50) // 상단 두번째(wide 2열) 카드 크롭 세로
  status             ArticleStatus @default(PUBLISHED)
  viewCount          Int           @default(0)
  isFrontpageTop     Boolean       @default(false) // 1면톱 - 사이트 전체 1건만 true

  authorId String
  author   User   @relation(fields: [authorId], references: [id])

  categoryId String?
  category   Category? @relation(fields: [categoryId], references: [id])

  images    ArticleImage[]
  comments  Comment[]
  keywords  Keyword[] // 관리자가 미리 만든 키워드 중 선택 (다대다)
  poll      Poll?
  savedBy   SavedArticle[]
  donations Donation[] // 이 기사에서 들어온 후원 (2026-10-08)

  // 관련기사 — 작성자가 발행된 기사 중에서 직접 선택 (기능정의서 8.2). 방향성 있는 자기참조 다대다.
  relatedArticles Article[] @relation("RelatedArticles")
  relatedFrom     Article[] @relation("RelatedArticles")

  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  publishedAt DateTime?
  photoUsages PhotoUsage[] // 사진 뱅크 사용 이력 (2026-10-09)
}

// 독자의 "기사 저장"(북마크) 기능 (기능정의서 3.1)
model SavedArticle {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  articleId String
  article   Article  @relation(fields: [articleId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([userId, articleId])
}

// 기사 첨부 설문(투표) — 기사 1건당 최대 1개, 옵션 2개 이상
model Poll {
  id        String       @id @default(cuid())
  articleId String       @unique
  article   Article      @relation(fields: [articleId], references: [id], onDelete: Cascade)
  question  String
  options   PollOption[]
  votes     PollVote[]
  createdAt DateTime     @default(now())
}

model PollOption {
  id     String     @id @default(cuid())
  pollId String
  poll   Poll       @relation(fields: [pollId], references: [id], onDelete: Cascade)
  text   String
  order  Int        @default(0)
  votes  PollVote[]
}

model PollVote {
  id        String     @id @default(cuid())
  pollId    String
  poll      Poll       @relation(fields: [pollId], references: [id], onDelete: Cascade)
  optionId  String
  option    PollOption @relation(fields: [optionId], references: [id], onDelete: Cascade)
  userId    String
  user      User       @relation(fields: [userId], references: [id])
  createdAt DateTime   @default(now())

  @@unique([pollId, userId]) // 사용자당 설문 1표
}

// 관리자가 미리 만들어두는 키워드 목록 (카테고리와 별도 체계) — 여론/단독 등은 이제 카테고리가 아니라 키워드
model Keyword {
  id        String   @id @default(cuid())
  name      String   @unique
  createdAt DateTime @default(now())

  articles Article[]
}

// 에디터 특수문자 세트 — 편집장이 에디터 안의 레이어(모달)에서 카테고리별로 추가/삭제 (2026-09-11: 관리자 메뉴 → 에디터 내장으로 이동)
model SpecialCharacter {
  id       String  @id @default(cuid())
  char     String // 실제 문자 (▶, ■, ※ 등)
  label    String? // 관리용 설명
  category String  @default("자주쓰는") // 모달 상단 탭 — 자주쓰는/화살표/단위 등, 편집장이 새 이름을 입력하면 새 탭이 생김
  order    Int     @default(0)
}

model ArticleImage {
  id        String  @id @default(cuid())
  articleId String
  article   Article @relation(fields: [articleId], references: [id], onDelete: Cascade)
  url       String
  caption   String?
  order     Int     @default(0)
}

// 정기후원 — 세제혜택(기부금영수증) 없는 단순 결제구독, 금액 자유입력.
// PG(결제대행)사 계약정보가 아직 없어 실제 카드결제 연동은 보류 상태 — 지금은 구독 상태/왕관뱃지 로직만 구현.
model Donation {
  id          String         @id @default(cuid())
  userId      String? // 2026-10-08부터 비로그인 후원 허용(옛 사이트와 동일) — 로그인 상태로 후원하면 연결
  user        User?          @relation(fields: [userId], references: [id])
  donorName   String? // 후원자 이름 — 후원 폼에서 직접 입력 (2026-10-08 신설)
  articleId   String? // 후원이 시작된 기사 — 관리자 후원내역의 "기사번호(기사확인)" (2026-10-08 신설)
  article     Article?       @relation(fields: [articleId], references: [id], onDelete: SetNull)
  oid         String?        @unique // 이니시스 주문번호 — 결제 요청마다 새로 발급 (2026-10-08 신설)
  tid         String? // 이니시스 거래번호 — 승인 성공 시 기록 (취소·조회 시 필요)
  payMethod   String? // 결제수단 (Card, DirectBank 등)
  paidAt      DateTime? // 결제 승인 시각
  amount      Int // 후원금액(원), 자유입력 — 2026-10-08부터 일시 후원(1건=1회 결제)
  phone       String? // 후원 신청 시 입력한 연락처 — 관리자 후원리스트에서 닉네임/프로필사진/이메일과 함께 노출 (2026-09-12 신설)
  status      DonationStatus @default(ACTIVE)
  // 특정 기자를 지정한 후원인 경우 (기능정의서 7 "기자별 정산") — null이면 사이트 전체 후원(정산 시 미지정으로 집계)
  reporterId  String?
  reporter    User?          @relation("DonationReporter", fields: [reporterId], references: [id])
  settled     Boolean        @default(false) // 정산 완료 처리된 건 — 재선택 불가 (기능정의서 7.1)
  settledAt   DateTime?
  startedAt   DateTime       @default(now())
  cancelledAt DateTime?
}

// 줄광고 — 기사 본문 맨 마지막에 핫핑크 화살표 + 기사제목 같은 굵은 글씨 한 줄로 노출되는 텍스트형 광고.
// 배너(이미지)와 달리 문안(text)+링크만 가짐. 최대 10개까지 화면에 노출(order 순), 그 이상은 비활성 처리해서 대기시켜둠 (2026-09-12 신설)
model LineAd {
  id        String   @id @default(cuid())
  text      String
  linkUrl   String
  order     Int      @default(0)
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// 배너 광고 — 홈화면은 슬롯(3/5/7번째 카드 자리)당 활성 배너 1개, 기사본문은 여러 개를 order 순으로 노출 (기능정의서 5)
model Banner {
  id        String          @id @default(cuid())
  placement BannerPlacement
  imageUrl  String
  linkUrl   String
  order     Int             @default(0)
  active    Boolean         @default(true)
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt
}

// 사이트 전역 설정값 — 기사 본문 삽입 광고 개수 + 애드센스 설정 (싱글턴 row, id 고정)
model SiteConfig {
  id                  String    @id @default("singleton")
  articleBannerCount  Int       @default(0)
  // 구글 애드센스 자동광고 (2026-10-09, 관리자 광고 관리 → 애드센스 탭) — 켜기/끄기와 화면 종류별 노출
  adsenseEnabled      Boolean   @default(true)
  adsenseOnHome       Boolean   @default(true) // 홈·카테고리 목록
  adsenseOnArticle    Boolean   @default(true) // 기사 화면
  adsenseOnOther      Boolean   @default(true) // 검색·회사소개 등 그 밖의 화면
  // 사진 뱅크 자동 수집기 (2026-10-09) — 주기(분, 0이면 끔)와 마지막 실행 시각
  photoCollectMinutes Int       @default(60)
  photoCollectAt      DateTime?
}

// 범용 사진 라이브러리 — 기사에 종속되지 않는 재사용 가능한 사진 모음 (기능정의서 8.1)
model Photo {
  id         String     @id @default(cuid())
  url        String
  filename   String?
  title      String? // 캡션(초안) — 갤러리 모달 업로드 시 입력 (2026-09-11 신설)
  uploaderId String
  uploader   User       @relation(fields: [uploaderId], references: [id])
  tags       PhotoTag[] // 상황 태그(기자회견·회의·현장·프로필 등) — 2026-10-09 사진 뱅크에서 의미 변경
  createdAt  DateTime   @default(now())

  // ── 사진 뱅크 (2026-10-09, 기능정의 v0.1) — 출처가 확인된 사진만. 옛 갤러리 사진은 sourceType 비어 있음(출처 미입력)
  sourceType    PhotoSource?
  license       String? // 공공누리 1유형, CC BY-SA 4.0 등
  sourceUrl     String? // 원본 페이지
  viaArticleUrl String? // 타 언론 기사 "제공" 사진이면 그 기사
  takenAt       DateTime? // 촬영일
  photographer  String? // 촬영자·기관
  credit        String? // 사진=○○ (출처 유형별 자동, 수정 가능)
  people        Person[]
  usages        PhotoUsage[]
  hash          String?      @unique // 이미지 내용 해시(sha1) — 수집기 중복 제거용 (2026-10-09)
}

// 사진 출처 유형 (사진 뱅크)
enum PhotoSource {
  KOGL // 공공누리
  PARTY // 정당·의원실 배포
  PUBLIC_DOMAIN // 퍼블릭 도메인
  CC // 크리에이티브 커먼즈
  OWN // 자체 촬영
  AI_RECON // AI 재구성
  AI_GEN // AI 생성
}

model PhotoTag {
  id     String  @id @default(cuid())
  name   String  @unique
  photos Photo[]
}

// 사진 뱅크 인물 목록 — 편집장이 관리 (2026-10-09)
model Person {
  id              String    @id @default(cuid())
  name            String    @unique
  aliases         String? // 별칭, 쉼표로 구분
  affiliation     String? // 소속
  title           String? // 직함
  photos          Photo[]
  createdAt       DateTime  @default(now())
  lastCollectedAt DateTime? // 자동 수집기가 마지막으로 이 인물을 찾아본 시각 (돌아가며 수집)
}

// 사진 뱅크 수신함 — 자동 수집기가 가져온 후보. 승인해야 사진 뱅크에 들어감 (2026-10-09, 3단계)
// 용량 때문에 수신함 단계에서는 원본 링크만 두고, 승인할 때 파일을 우리 저장소로 복사한다.
model PhotoInbox {
  id            String      @id @default(cuid())
  origin        String // 수집 경로 (naver 등)
  imageUrl      String      @unique
  thumbUrl      String
  pageUrl       String?
  viaArticleUrl String?
  title         String? // 기사 제목
  caption       String?
  provider      String? // "○○ 제공"의 주체
  sourceType    PhotoSource
  license       String?
  credit        String?
  takenAt       DateTime?
  peopleIds     String? // 캡션에서 찾은 등록 인물 id (쉼표)
  hash          String?     @unique
  status        InboxStatus @default(PENDING)
  photoId       String?
  createdAt     DateTime    @default(now())
  decidedAt     DateTime?

  @@index([status, createdAt])
}

enum InboxStatus {
  PENDING
  APPROVED
  REJECTED
}

// 사진 사용 이력 — 기사 저장 때 본문·카드뉴스·커버에 들어 있는 사진을 기록 (2026-10-09)
model PhotoUsage {
  id          String   @id @default(cuid())
  photoId     String
  photo       Photo    @relation(fields: [photoId], references: [id], onDelete: Cascade)
  articleId   String
  article     Article  @relation(fields: [articleId], references: [id], onDelete: Cascade)
  firstUsedAt DateTime @default(now())

  @@unique([photoId, articleId])
  @@index([firstUsedAt])
}

// 정치신세계 자동 영상 카드 — 유튜브 채널에서 가져온 쇼츠/영상/라이브. Article과 별도 모델 (기능정의서 4.2.1)
enum VideoKind {
  SHORT
  VIDEO
  LIVE
}

model VideoCard {
  id           String    @id @default(cuid())
  youtubeId    String    @unique
  title        String
  thumbnailUrl String
  kind         VideoKind
  publishedAt  DateTime
  createdAt    DateTime  @default(now())
  showOnMain   Boolean   @default(true) // 전체(인덱스) 피드 노출 여부 — 편집장이 관리화면에서 개별로 끌 수 있음 (2026-09-11 신설)
  coverFocalX  Int       @default(50) // 정치신세계 피처 카드 크롭 가로 (0=왼쪽, 100=오른쪽)
  coverFocalY  Int       @default(50) // 정치신세계 피처 카드 크롭 세로 (0=위, 100=아래)
}

// 뉴스레터 발송 이력 — 중복발송 방지 확인용 로그 (기능정의서 6)
model NewsletterSend {
  id             String   @id @default(cuid())
  weekStart      DateTime
  weekEnd        DateTime
  recipientCount Int
  sentAt         DateTime @default(now())
}

model Comment {
  id        String   @id @default(cuid())
  articleId String
  article   Article  @relation(fields: [articleId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  content   String
  createdAt DateTime @default(now())
}

// 방문 분석(GA) 하루치 보고서 — 매일 한 번 자동 생성해 저장, 관리자 "방문 분석" 화면이 읽음 (2026-10-08)
model AnalyticsSnapshot {
  id        String   @id // 한국 날짜 YYYY-MM-DD
  data      Json
  createdAt DateTime @default(now())
}
